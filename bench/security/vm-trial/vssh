#!/usr/bin/expect -f
# vssh <ip> <command>: run a command in the Tart VM as admin (password admin).
set timeout 600
set ip [lindex $argv 0]
set cmd [lindex $argv 1]
log_user 1
spawn ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR admin@$ip $cmd
expect {
  -re "assword:" { send "admin\r"; exp_continue }
  eof
}
catch wait result
exit [lindex $result 3]
