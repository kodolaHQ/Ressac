# Shared by several screens.

# Used by the i18n tests: a plural.
test-plural = { $count ->
    [one] { $count } tab
   *[other] { $count } tabs
}
# Used by the i18n tests: only in English, so other languages fall back to it.
test-english-only = Only in English

## The « Active l'IA » card (AiAsleep), shown instead of an AI feature while AI is off.

ai-asleep-title = AI is asleep
ai-asleep-enable = Turn on AI
ai-asleep-later = Later
ai-asleep-agent = An agent that browses for you, searches, compares and builds apps.
ai-asleep-apps = Apps the agent builds for you, running on your Mac.
ai-asleep-actions = Tasks the agent runs from a word, in ⌘T or on the home page.
ai-asleep-widgets = Widgets on the home page, kept up to date by the AI.
ai-asleep-workflows = The steps behind a widget or an action, written with the agent.
ai-asleep-review = What the agent changed in a project, to read and comment on.
ai-asleep-settings = The agent, local AI and workshop are set up here once AI is on.

# A frame (widget, app home, component) whose process kept stopping: it stays empty.
frame-stopped = This display stopped several times: it stays empty.
