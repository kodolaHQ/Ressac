#!/bin/sh
# Wraps the fake docker (fake-docker.cjs): logs each call to $FAKE_DOCKER_LOG, then maps the Firefox container name
# back to the one the fake knows (it locates `docker exec` arguments by the literal "ressac-workshop").
[ -n "$FAKE_DOCKER_LOG" ] && printf '%s\n' "$*" >> "$FAKE_DOCKER_LOG"
# FAKE_DOCKER_NO_CONTAINER=1: no container until `run -d` (tests read its arguments); with FAKE_DOCKER_RUN_FAILED=1,
# the first `run -d` fails like a port already taken.
if [ "$FAKE_DOCKER_NO_CONTAINER" = 1 ]; then
  mark="$RESSAC_ROOT/fake-docker-container"
  [ "$1" = inspect ] && [ ! -e "$mark" ] && exit 1
  if [ "$1 $2" = "run -d" ]; then
    if [ "$FAKE_DOCKER_RUN_FAILED" = 1 ] && [ ! -e "$mark.failed" ]; then
      : > "$mark.failed"
      echo "Bind for 127.0.0.1:5300 failed: port is already allocated" >&2
      exit 125
    fi
    : > "$mark"
  fi
fi
# FAKE_DOCKER_SLOW_APP_STOP=<s>: one app's stop (its kill script names RESSAC_APP=<folder>, not the orphan sweep's
# RESSAC_APP=.*) answers that late, like a slow docker.
if [ -n "$FAKE_DOCKER_SLOW_APP_STOP" ]; then
  case "$*" in *"RESSAC_APP=.*"*) ;; *RESSAC_APP=*kill*) sleep "$FAKE_DOCKER_SLOW_APP_STOP" ;; esac
fi
# FAKE_DOCKER_SLOW_SESSION_STOP=<s>: a session's stop (not the orphan sweep's RESSAC_SESSION=.*) answers that late.
if [ -n "$FAKE_DOCKER_SLOW_SESSION_STOP" ]; then
  case "$*" in *"RESSAC_SESSION=.*"*) ;; *RESSAC_SESSION=*signaler*) sleep "$FAKE_DOCKER_SLOW_SESSION_STOP" ;; esac
fi
for a; do
  shift
  [ "$a" = ressac-workshop-firefox ] && a=ressac-workshop
  set -- "$@" "$a"
done
exec "$(dirname "$0")/fake-docker.cjs" "$@"
