#!/bin/sh
# Wraps the fake docker (fake-docker.cjs): logs each call to $FAKE_DOCKER_LOG, then maps the Firefox container name
# back to the one the fake knows (it locates `docker exec` arguments by the literal "webaios-workshop").
[ -n "$FAKE_DOCKER_LOG" ] && printf '%s\n' "$*" >> "$FAKE_DOCKER_LOG"
# FAKE_DOCKER_NO_CONTAINER=1: no container until `run -d` (tests read its arguments); with FAKE_DOCKER_RUN_FAILED=1,
# the first `run -d` fails like a port already taken.
if [ "$FAKE_DOCKER_NO_CONTAINER" = 1 ]; then
  marque="$WEBAIOS_ROOT/faux-docker-conteneur"
  [ "$1" = inspect ] && [ ! -e "$marque" ] && exit 1
  if [ "$1 $2" = "run -d" ]; then
    if [ "$FAKE_DOCKER_RUN_FAILED" = 1 ] && [ ! -e "$marque.echec" ]; then
      : > "$marque.echec"
      echo "Bind for 127.0.0.1:5300 failed: port is already allocated" >&2
      exit 125
    fi
    : > "$marque"
  fi
fi
# FAKE_DOCKER_SLOW_APP_STOP=<s>: one app's stop (its kill script names WEBAIOS_APP=<folder>, not the orphan sweep's
# WEBAIOS_APP=.*) answers that late, like a slow docker.
if [ -n "$FAKE_DOCKER_SLOW_APP_STOP" ]; then
  case "$*" in *"WEBAIOS_APP=.*"*) ;; *WEBAIOS_APP=*kill*) sleep "$FAKE_DOCKER_SLOW_APP_STOP" ;; esac
fi
for a; do
  shift
  [ "$a" = webaios-workshop-firefox ] && a=webaios-workshop
  set -- "$@" "$a"
done
exec "$(dirname "$0")/fake-docker.cjs" "$@"
