#!/bin/sh
# Wraps the fake docker (faux-docker.cjs): logs each call to $FAUX_DOCKER_JOURNAL, then maps the Firefox container name
# back to the one the fake knows (it locates `docker exec` arguments by the literal "webaios-atelier").
[ -n "$FAUX_DOCKER_JOURNAL" ] && printf '%s\n' "$*" >> "$FAUX_DOCKER_JOURNAL"
# FAUX_DOCKER_SANS_CONTENEUR=1: no container until `run -d` (tests read its arguments); with FAUX_DOCKER_RUN_ECHOUE=1,
# the first `run -d` fails like a port already taken.
if [ "$FAUX_DOCKER_SANS_CONTENEUR" = 1 ]; then
  marque="$WEBAIOS_RACINE/faux-docker-conteneur"
  [ "$1" = inspect ] && [ ! -e "$marque" ] && exit 1
  if [ "$1 $2" = "run -d" ]; then
    if [ "$FAUX_DOCKER_RUN_ECHOUE" = 1 ] && [ ! -e "$marque.echec" ]; then
      : > "$marque.echec"
      echo "Bind for 127.0.0.1:5300 failed: port is already allocated" >&2
      exit 125
    fi
    : > "$marque"
  fi
fi
# FAUX_DOCKER_ARRET_APP_LENT=<s>: one app's stop (its kill script names WEBAIOS_APP=<folder>, not the orphan sweep's
# WEBAIOS_APP=.*) answers that late, like a slow docker.
if [ -n "$FAUX_DOCKER_ARRET_APP_LENT" ]; then
  case "$*" in *"WEBAIOS_APP=.*"*) ;; *WEBAIOS_APP=*kill*) sleep "$FAUX_DOCKER_ARRET_APP_LENT" ;; esac
fi
for a; do
  shift
  [ "$a" = webaios-atelier-firefox ] && a=webaios-atelier
  set -- "$@" "$a"
done
exec "$(dirname "$0")/faux-docker.cjs" "$@"
