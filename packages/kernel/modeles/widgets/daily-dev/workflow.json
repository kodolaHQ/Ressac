{
  "version": 1,
  "blocks": [
    {
      "id": "fil",
      "type": "source.page",
      "name": "Ton fil daily.dev",
      "position": {
        "x": 0,
        "y": 0
      },
      "params": {
        "url": "https://app.daily.dev/",
        "account": true
      }
    },
    {
      "id": "liens",
      "type": "code",
      "name": "Les posts du fil",
      "position": {
        "x": 260,
        "y": 0
      },
      "params": {
        "source": "liens.mjs"
      }
    },
    {
      "id": "tri",
      "type": "ai.sort",
      "name": "Tri par Kev selon tes intérêts",
      "position": {
        "x": 520,
        "y": 0
      },
      "params": {
        "question": "Cet article intéresse-t-il quelqu'un qui suit : {config.interets} ?",
        "text": "Titre : {title}\nSource : {source}",
        "threshold": 0.6,
        "onError": "skip"
      }
    },
    {
      "id": "top",
      "type": "list.keep",
      "name": "Les 12 meilleurs",
      "position": {
        "x": 780,
        "y": 0
      },
      "params": {
        "count": 12
      }
    },
    {
      "id": "a-resumer",
      "type": "list.keep",
      "name": "Les 6 premiers à résumer",
      "position": {
        "x": 780,
        "y": 160
      },
      "params": {
        "count": 6
      }
    },
    {
      "id": "pages",
      "type": "source.page",
      "name": "Lire chaque article",
      "position": {
        "x": 1040,
        "y": 160
      },
      "params": {
        "url": "{url}",
        "perItem": true,
        "field": "page",
        "budgetSeconds": 60
      }
    },
    {
      "id": "resumes",
      "type": "ai.write",
      "name": "Résumé par Gemma",
      "position": {
        "x": 1300,
        "y": 160
      },
      "params": {
        "prompt": "Résume en français, en 2 phrases au plus, l'article dont le contenu est ci-dessous. Réponds uniquement par le résumé.\n\nTitre : {title}\n\n--- DÉBUT DU CONTENU ---\n{page.text}\n--- FIN DU CONTENU ---",
        "perItem": true,
        "field": "summary",
        "maxText": 12000,
        "reuse": "url",
        "budgetSeconds": 60
      }
    },
    {
      "id": "articles",
      "type": "code",
      "name": "Articles et résumés",
      "position": {
        "x": 1560,
        "y": 0
      },
      "params": {
        "source": "articles.mjs"
      }
    },
    {
      "id": "sortie",
      "type": "output",
      "position": {
        "x": 1820,
        "y": 0
      },
      "params": {
        "to": "widget"
      }
    }
  ],
  "links": [
