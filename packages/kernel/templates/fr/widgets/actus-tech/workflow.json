{
  "version": 1,
  "blocks": [
    {
      "id": "flux",
      "type": "source.feed",
      "name": "Flux tech",
      "position": {
        "x": 0,
        "y": 0
      },
      "params": {
        "urls": [
          "https://news.ycombinator.com/rss",
          "https://lobste.rs/rss",
          "https://www.theverge.com/rss/index.xml",
          "https://next.ink/feed/"
        ]
      }
    },
    {
      "id": "uniques",
      "type": "list.dedupe",
      "name": "Sans doublons",
      "position": {
        "x": 260,
        "y": 0
      },
      "params": {
        "keys": [
          "url",
          "title"
        ]
      }
    },
    {
      "id": "tri",
      "type": "ai.sort",
      "name": "Tri par Kev selon tes intérêts",
      "position": {
        "x": 520,
        "y": 0
      },
      "params": {
        "question": "Cet article intéresse-t-il quelqu'un qui suit : {config.interets} ?",
        "text": "Titre : {title}\nSource : {source}",
        "threshold": 0.6,
        "onError": "skip"
      }
    },
    {
      "id": "top",
      "type": "list.keep",
      "name": "Les 15 meilleurs",
      "position": {
        "x": 780,
        "y": 0
      },
      "params": {
        "count": 15
      }
    },
    {
      "id": "a-resumer",
      "type": "list.keep",
      "name": "Les 8 premiers à résumer",
      "position": {
        "x": 780,
        "y": 160
      },
      "params": {
        "count": 8
      }
    },
    {
      "id": "pages",
      "type": "source.page",
      "name": "Lire chaque article",
      "position": {
        "x": 1040,
        "y": 160
      },
      "params": {
        "url": "{url}",
        "perItem": true,
        "field": "page",
        "budgetSeconds": 60
      }
    },
    {
      "id": "resumes",
      "type": "ai.write",
      "name": "Résumé par l'IA",
      "position": {
        "x": 1300,
        "y": 160
      },
      "params": {
        "prompt": "Résume en français, en 2 phrases au plus, le contenu de la page ci-dessous. Réponds uniquement par le résumé.\n\nTitre : {title}\n\n--- DÉBUT DU CONTENU ---\n{page.text}\n--- FIN DU CONTENU ---",
        "perItem": true,
        "field": "summary",
        "maxText": 12000,
        "reuse": "url",
        "budgetSeconds": 60
      }
    },
    {
      "id": "articles",
      "type": "code",
      "name": "Articles et résumés",
      "position": {
        "x": 1560,
        "y": 0
      },
      "params": {
        "source": "articles.mjs"
      }
    },
    {
      "id": "sortie",
      "type": "output",
      "position": {
        "x": 1820,
        "y": 0
      },
      "params": {
        "to": "widget"
      }
    }
  ],
  "links": [
    {
      "from": "flux",
      "to": "uniques"
    },
    {
      "from": "uniques",
      "to": "tri"
    },
    {
      "from": "tri",
      "to": "top"
    },
    {
      "from": "top",
      "to": "a-resumer"
    },
    {
      "from": "a-resumer",
      "to": "pages"
    },
    {
      "from": "pages",
      "to": "resumes"
    },
    {
      "from": "top",
      "to": "articles"
    },
    {
      "from": "resumes",
      "to": "articles"
    },
    {
      "from": "articles",
      "to": "sortie"
    }
  ]
}
