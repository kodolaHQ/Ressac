# Texts the host (the agent's process) shows the user: Settings, cards, notifications.

host-actions-no-kernel = The actions service is not answering (agent stopped?)
host-widgets-no-kernel = The widgets service is not answering (agent stopped?)
host-action-launch-failed = The action could not be launched
host-action-delete-failed = The action could not be deleted
host-kernel-not-started = the agent's kernel did not start
host-invalid-params = Invalid parameters
host-external-starting = The external MCP is starting
host-no-key = No key saved for the compatible API (Settings › Agent).
host-engine-incomplete-ollama = Set Ollama's address and model in Settings › Agent.
host-engine-incomplete-api = Set the compatible API's address and model in Settings › Agent.
host-engine-in-settings = { $problem } (Settings › Agent)
host-invalid-key = Invalid key: only letters, digits and . _ ~ + / = : -
host-unsupported-model = Unsupported model
host-docker-not-started = Docker did not start
host-ollama-down = Ollama does not answer at this address.
host-pull-busy = A download is already in progress
host-account-api-key = API key
host-grant-site-app = Touch-ups and reading of the app granted
host-grant-reads = Reads with your account: { $domains }
host-unknown-agent = Unknown agent.
host-workshop-not-started = The agent's workshop is not started: see Workshop.
host-codex-missing = Codex is not installed in the workshop yet: open the agent view or restart the workshop (Workshop section).
host-cli-downloading = Downloading { $agent }… { $percent } %
host-cli-downloading-size = Downloading { $agent }…
host-cli-slow = The { $agent } download is still running: try again in a moment.
host-cli-hash = The { $agent } download does not match the expected version: try again.
host-cli-cancelled = { $agent } download cancelled
host-workshop-busy = An operation on the workshop is already in progress.
host-ai-ready-title = Local AI is ready
host-ai-ready-text = The models are downloaded: monitoring and decisions run on your Mac.
host-ai-failed-title = The local AI download failed
host-ai-failed-text = { $reason }. Try again from Settings › Local AI.
host-site-trash-failed = Folder not moved to the trash: the sign-in and memory are erased, the folder stays.
host-review-no-comment = No comment to send.
host-review-failed = the comparison failed
host-invalid-address = Invalid address
host-invalid-argument = Invalid argument
host-invalid-request = Invalid request
host-invalid-grant-request = Invalid grant request
host-widget-not-found = Widget not found
host-review-unknown-comparison = This comparison is no longer kept: refresh the review.
host-engine-url-invalid = Invalid address (https://…)
host-review-unknown-project = unknown project
host-review-file-absent = file absent from the review
host-ask-shown-pages = Ressac already suggested these history pages, it was none of them:
host-machine-unsupported = This Mac cannot run the workshop machine (virtualization unavailable).
host-machine-socket-too-long = The workshop machine's folder has too long a path: { $path }
host-machine-path-invalid = This path cannot be mounted in the workshop machine: { $path }
host-machine-download-failed = The workshop machine's download failed: { $detail }
host-machine-cancelled = Workshop machine download cancelled
host-machine-start-failed = The workshop machine did not start: { $detail }
host-machine-export-failed = The workshop's logins could not be saved, the machine is kept: { $detail }
host-machine-in-use = The workshop machine runs with another configuration and still serves a session; it will restart once it is free. Try again later.
host-machine-removed = The workshop machine was removed: install it in Settings › Workshop (“Install the machine”).
host-machine-remove-failed = The workshop machine could not be removed: { $detail }
host-machine-damaged = The workshop machine is in an unexpected state. Restart the Mac; if it still does not start, remove it anyway in Settings › Workshop (Claude and Codex will need signing in again).
